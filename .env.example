# =====================================================================
# EMDI Cooperative Management System — environment variables
#
# Backend: copy the BACKEND section to backend/.env
# Frontend: copy the FRONTEND section to frontend/.env
# Never commit real .env files.
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND (backend/.env)
# ---------------------------------------------------------------------

# Settings module: config.settings.dev (default for manage.py),
# config.settings.prod (default for wsgi/asgi), config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=False
# Comma-separated host names. Wildcards are refused in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — either DATABASE_URL, or the DB_* variables
# DATABASE_URL=postgres://emdi_coop:password@localhost:5432/emdi_coop
DB_NAME=emdi_coop
DB_USER=emdi_coop
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Base URL used in activation/reset emails. With the SPA's hash router include
# the "#", e.g. http://localhost:5173/cooperative-management-system/#
FRONTEND_URL=http://localhost:5173

# Reverse proxies in front of Django (1 on Render/most PaaS, 0 locally).
# Used to find the real client IP for throttling and the audit log.
NUM_PROXIES=0

# Refresh-token cookie. Use SameSite=None (with Secure=True) only if the SPA
# and API are on different sites.
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=True
# REFRESH_COOKIE_DOMAIN=.example.org

# One-time link lifetimes
ACCOUNT_ACTIVATION_TIMEOUT_HOURS=72
PASSWORD_RESET_TIMEOUT_MINUTES=60

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Django support console path (Super Administrator only)
DJANGO_ADMIN_URL=django-admin/

# Private file storage for member photos and documents
# MEDIA_ROOT=/var/lib/emdi-coop/media

# Email (activation links, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EMDI Cooperative <no-reply@example.com>

# Shared cache for rate limiting across gunicorn workers (production).
# Default: the database cache (created by `manage.py createcachetable`).
# Optional Redis: CACHE_URL=redis://host:6379/0  (then `pip install redis`)
# CACHE_URL=

# Production security
SECURE_SSL_REDIRECT=True
# SECURE_HSTS_PRELOAD=False  # opt in only when every subdomain is HTTPS-only
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# FRONTEND (frontend/.env)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
# hash (default): /#/member URLs, works on static hosts such as GitHub Pages.
# browser: clean /member URLs; the host must rewrite unknown paths to index.html.
VITE_ROUTER=hash
