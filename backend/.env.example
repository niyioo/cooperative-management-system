# Copy to backend/.env for running Django outside Docker. Never commit the real file.

# Off unless you are developing locally. With DEBUG off, SECRET_KEY is required.
DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=api.example.com

# Either one connection URL (hosted databases) ...
# DATABASE_URL=postgres://user:password@host:5432/dbname
# ... or the individual settings:
DB_NAME=cooperative_db
DB_USER=coop_user
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# The dashboard's address(es). Comma-separated.
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Sign-in cookie. If the dashboard and API are on different domains
# (e.g. GitHub Pages + an API host), set SAMESITE=None (HTTPS only).
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=True
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Behind an HTTPS proxy. Only enable HSTS once every subdomain serves HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
TIME_ZONE=Africa/Lagos
